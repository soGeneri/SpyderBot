[Unit]
Description=Freenove Hexapod Robot Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=REPO_PATH/Code/Server
ExecStart=/usr/bin/python3 REPO_PATH/Code/Server/main.py -n -t
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
